#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6
#define HOMEROW 7

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&nice_view_spi { cs-gpios = <&pro_micro 1 GPIO_ACTIVE_HIGH>; };

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph 

    combos {
        compatible = "zmk,combos";

        combo_left_ctrl {
            timeout-ms = <30>;
            key-positions = <13 23>;
            bindings = <&kp LCTRL>;
        };

        combo_left_cmd {
            timeout-ms = <30>;
            key-positions = <12 22>;
            bindings = <&kp LGUI>;
        };

        combo_left_cmd_ctrl {
            timeout-ms = <30>;
            key-positions = <22 23>;
            bindings = <&kp LC(LGUI)>;
        };

        combo_left_cmd_shift {
            timeout-ms = <30>;
            key-positions = <21 22>;
            bindings = <&kp LS(LGUI)>;
        };

        combo_to_homerow {
            timeout-ms = <30>;
            key-positions = <12 13>;
            bindings = <&to HOMEROW>;
        };

        combo_backspace {
            timeout-ms = <30>;
            key-positions = <6 7>;
            bindings = <&kp BACKSPACE>;
        };

        combo_tab {
            timeout-ms = <30>;
            key-positions = <7 8>;
            bindings = <&kp TAB>;
        };

        combo_delete {
            timeout-ms = <30>;
            key-positions = <8 9>;
            bindings = <&kp DELETE>;
        };

        combo_space_right {
            timeout-ms = <30>;
            key-positions = <16 17>;
            bindings = <&kp SPACE>;
        };

        combo_escape_right {
            timeout-ms = <30>;
            key-positions = <17 18>;
            bindings = <&kp ESCAPE>;
        };

        combo_enter_right {
            timeout-ms = <30>;
            key-positions = <18 19>;
            bindings = <&kp ENTER>;
        };

        combo_right_ctrl {
            timeout-ms = <30>;
            key-positions = <16 26>;
            bindings = <&kp RCTRL>;
        };

        combo_right_gui {
            timeout-ms = <30>;
            key-positions = <17 27>;
            bindings = <&kp RGUI>;
        };

        combo_right_shift {
            timeout-ms = <30>;
            key-positions = <18 28>;
            bindings = <&kp RSHFT>;
        };

        combo_right_alt {
            timeout-ms = <30>;
            key-positions = <19 29>;
            bindings = <&kp RALT>;
        };

        combo_f18 {
            timeout-ms = <30>;
            key-positions = <6 16>;
            bindings = <&kp F18>;
        };

        combo_f19 {
            timeout-ms = <30>;
            key-positions = <7 17>;
            bindings = <&kp F19>;
        };

        combo_f20 {
            timeout-ms = <30>;
            key-positions = <8 18>;
            bindings = <&kp F20>;
        };

        combo_to_scroll {
            timeout-ms = <30>;
            key-positions = <2 3>;
            bindings = <&to SCROLL>;
        };

        combo_to_snipe {
            timeout-ms = <30>;
            key-positions = <1 2>;
            bindings = <&to SNIPE>;
        };

        combo_left_shift {
            timeout-ms = <30>;
            key-positions = <11 21>;
            bindings = <&kp LSHFT>;
        };

        combo_left_alt {
            timeout-ms = <30>;
            key-positions = <10 20>;
            bindings = <&kp LALT>;
        };

        combo_to_default_left {
            timeout-ms = <30>;
            key-positions = <11 12>;
            bindings = <&to DEFAULT>;
        };

    };

    behaviors {
        home_num: home_num {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_NUM";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            flavor = "tap-preferred";
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        default_sym: default_sym {
            compatible = "zmk,behavior-hold-tap";
            label = "DEFAULT_SYM";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            flavor = "tap-preferred";
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp Q      &kp W         &kp E     &kp R         &kp T                                    &kp Y            &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D     &kp F         &kp G                                    &kp H            &kp J  &kp K      &kp L    &kp SEMI
&kp Z      &kp X         &kp C     &kp V         &kp B                                    &kp N            &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL  &kp LEFT_WIN  &kp LALT  &lt 6 ESCAPE  &home_num NUM ESCAPE   &lt 5 LA(GRAVE)  &kp ENTER  &default_sym SYM SPACE                    &kp RSHFT
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3         &kp NUMBER_4   &kp NUMBER_5                  &kp NUMBER_6   &kp NUMBER_7        &kp NUMBER_8      &kp NUMBER_9  &kp NUMBER_0
&kp LALT      &kp LSHFT      &kp LGUI             &kp LCTRL      &kp ENTER                     &kp BACKSLASH  &kp RGUI            &kp RSHFT         &kp RALT      &kp RCTRL
&kp GRAVE     &none          &none                &none          &kp BACKSPACE                 &kp SQT        &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp MINUS     &kp EQUAL
&trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans                                                  &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&bt BT_CLR       &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2    &none                       &kp HOME      &kp PAGE_DOWN  &kp PAGE_UP      &kp END       &none
&kp LALT         &kp LSHFT     &kp LGUI        &kp LCTRL       &bootloader                 &kp LEFT      &kp DOWN       &kp UP_ARROW     &kp RIGHT     &kp ENTER
&none            &none         &kp LG(LS(LEFT_BRACKET))  &kp LG(LS(RIGHT_BRACKET))  &none        &kp CAPSLOCK  &kp BACKSPACE  &kp F18          &none         &kp TAB
&trans           &trans        &trans        &trans        &trans       &trans  &trans  &trans                                                                 &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4   &none                   &none   &none  &none  &none  &none
&kp F5  &kp F6   &kp F7   &kp F8   &none                   &none   &none  &none  &none  &none
&kp F9  &kp F10  &kp F11  &kp F12  &none                   &none   &none  &none  &none  &none
&trans  &trans   &trans   &trans   &trans  &trans  &trans  &trans                       &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&kp N1          &kp N2          &kp N3        &kp N4     &kp N5                  &kp N6         &kp N7     &kp N8  &kp N9     &kp N0
&kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &none                   &kp PAGE_UP    &mkp LCLK  &none   &mkp RCLK  &mkp MCLK
&none           &none           &none         &none      &none                   &kp PAGE_DOWN  &none      &none   &none      &none
&none           &trans          &trans        &trans     &trans  &trans  &trans  &mo 3                                        &none
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &bootloader                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans                          &trans
            >;
        };

        homerow_layer {
            label = "HOME";
            bindings = <
&kp Q      &kp W         &kp E         &kp R         &kp T                                    &kp Y            &kp U         &kp I         &kp O        &kp P
&mt LALT A  &mt LSHFT S  &mt LGUI D    &mt LCTRL F   &kp G                                    &kp H            &mt RCTRL J   &mt RGUI K    &mt RSHFT L  &mt RALT SEMI
&kp Z      &kp X         &kp C         &kp V         &kp B                                    &kp N            &kp M         &kp COMMA     &kp DOT      &kp SLASH
&trans     &trans        &trans        &trans        &trans     &trans          &trans     &trans                                      &trans
            >;
        };
    };
};
